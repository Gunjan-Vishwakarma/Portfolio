# Resend API Key - Keep this private! (Never prefix with NEXT_PUBLIC_)
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=re_your_api_key_here

# The email where you want to receive contact inquiries
CONTACT_TO_EMAIL=gunjanvishwakarma418@gmail.com

# Verified sender address in Resend.
# For testing without a verified custom domain, you can use Resend's sandbox sender:
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Allowed Origin for API domain restriction (comma-separated if multiple domains)
# e.g. https://your-portfolio.vercel.app,https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:3000

